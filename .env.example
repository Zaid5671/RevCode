# Template for .env.local — copy this file to .env.local and fill in real values.
# .env.local is git-ignored. This file is committed, so it must only ever hold placeholders.
# Production values go into Vercel's Environment Variables (Phase 11), not a file.

# ── Database (Neon) ── filled in Phase 1 ─────────────────────────────────────────
# Neon dashboard → project → Connect → pick the branch; "Connection pooling" ON for
# DATABASE_URL (host contains "-pooler"), OFF for the other two.

# App connection: pooled, `dev` branch
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Migrations and seed: direct (unpooled), `dev` branch
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Automated tests only: direct, `test` branch (tests wipe this database)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-YYYY.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Better Auth) ── filled in Phase 4 ──────────────────────────────────────
# Where the app runs: always this locally; the live URL on Vercel
BETTER_AUTH_URL="http://localhost:3000"

# Signs login cookies. Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="REPLACE_WITH_32_RANDOM_BYTES_BASE64"

# ── Google sign-in ── filled in Phase 4 ──────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID="XXXXXXXXXXXX-XXXXXXXX.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-XXXXXXXXXXXXXXXX"
